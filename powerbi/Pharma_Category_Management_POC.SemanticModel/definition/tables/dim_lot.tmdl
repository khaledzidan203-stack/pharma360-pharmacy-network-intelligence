	partition dim_lot = m
		mode: import
		source =
				let
				  Source = Parquet.Document(File.Contents(PharmaDataRoot & "/05_executive_data/dimensions/dim_lot.parquet")),
				  Nested = Source,
				  Typed = Table.TransformColumnTypes(Nested, {{"id", type text}, {"world_id", type text}, {"event_at", type text}, {"known_at", type text}, {"ingested_at", type text}, {"validated_at", type text}, {"lot", type text}, {"sku", type text}, {"expiry_year", Int64.Type}, {"expiry_month", Int64.Type}, {"expiry_day", type text}, {"expiry_precision", type text}, {"manufactured_at", type text}, {"source", type text}, {"unit_cost_minor", Int64.Type}, {"withdrawal_at", type text}, {"supplier_lot_offer_id", type text}}, "en-US"),
				  Dates0 = Table.AddColumn(Typed, "Event Date", each if Record.Field(_, "event_at") = null then null else Date.From(DateTimeZone.SwitchZone(DateTimeZone.FromText(Record.Field(_, "event_at")), 3)), type date),
				  Dates1 = Table.AddColumn(Dates0, "Known Date", each if Record.Field(_, "known_at") = null then null else Date.From(DateTimeZone.SwitchZone(DateTimeZone.FromText(Record.Field(_, "known_at")), 3)), type date),
				  Dates2 = Table.AddColumn(Dates1, "Withdrawal Date", each if Record.Field(_, "withdrawal_at") = null then null else Date.From(DateTimeZone.SwitchZone(DateTimeZone.FromText(Record.Field(_, "withdrawal_at")), 3)), type date)
				in
				  Dates2

