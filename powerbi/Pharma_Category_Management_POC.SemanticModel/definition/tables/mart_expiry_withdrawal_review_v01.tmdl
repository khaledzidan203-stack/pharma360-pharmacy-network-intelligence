		formatString: #,##0
		displayFolder: 14 Expiry Decision Review
		lineageTag: 07d6ab98-af98-5d48-ae01-f6bc638d8cde

	measure 'P14 Due Category Gradient Hex' = VAR V=[P14 Withdrawal Due Units] VAR Items=FILTER(ALLSELECTED(mart_expiry_withdrawal_review_v01[category]),NOT ISBLANK([P14 Withdrawal Due Units])) VAR LO=MINX(Items,[P14 Withdrawal Due Units]) VAR HI=MAXX(Items,[P14 Withdrawal Due Units]) VAR T=DIVIDE(V-LO,HI-LO,0.5) RETURN SWITCH(TRUE(),ISBLANK(V),"#8092A8",T<0.125,"#F6D6E0",T<0.250,"#EDB6C6",T<0.375,"#E9A8BA",T<0.500,"#DF92AA",T<0.625,"#D77D99",T<0.750,"#CD6287",T<0.875,"#BE4A72","#9B2A55")
		displayFolder: 14 Expiry Decision Review
		lineageTag: 2519b13d-ba34-582f-8589-85cea55117d9

	measure 'P14 Expiry Month Gradient Hex' = VAR V=[P14 Physical Qty] VAR Items=FILTER(ALLSELECTED(mart_expiry_withdrawal_review_v01[expiry_month_label]),NOT ISBLANK([P14 Physical Qty])) VAR LO=MINX(Items,[P14 Physical Qty]) VAR HI=MAXX(Items,[P14 Physical Qty]) VAR T=DIVIDE(V-LO,HI-LO,0.5) RETURN SWITCH(TRUE(),ISBLANK(V),"#8092A8",T<0.125,"#C6E8F6",T<0.250,"#B2DDF2",T<0.375,"#9ED1EA",T<0.500,"#86C1E3",T<0.625,"#65AED9",T<0.750,"#4B9ACA",T<0.875,"#3287BC","#1B70AC")
		displayFolder: 14 Expiry Decision Review
		lineageTag: dbb410b3-c273-5330-8791-9d8ed67d3fb7

	measure 'P14 Long Category Gradient Hex' = VAR V=[P14 Long Life ATP] VAR Items=FILTER(ALLSELECTED(mart_expiry_withdrawal_review_v01[category]),NOT ISBLANK([P14 Long Life ATP])) VAR LO=MINX(Items,[P14 Long Life ATP]) VAR HI=MAXX(Items,[P14 Long Life ATP]) VAR T=DIVIDE(V-LO,HI-LO,0.5) RETURN SWITCH(TRUE(),ISBLANK(V),"#8092A8",T<0.125,"#F4E5C9",T<0.250,"#F0D9B4",T<0.375,"#ECCD9F",T<0.500,"#E4BC85",T<0.625,"#DCAE68",T<0.750,"#CF974C",T<0.875,"#BD7B32","#98601B")
		displayFolder: 14 Expiry Decision Review
		lineageTag: dc657d0e-5b11-5fb9-b089-d518b9e9b7c6

