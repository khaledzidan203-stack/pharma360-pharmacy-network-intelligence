table mart_expiry_withdrawal_review_v01
	lineageTag: 9e6d3786-3505-5b2a-873a-cab08fdc65df

	measure 'P14 Withdrawal Due Units' = SUM(mart_expiry_withdrawal_review_v01[withdrawal_due_physical_units])
		formatString: #,##0
		displayFolder: 14 Expiry Decision Review
		lineageTag: 8660de51-f0a1-5207-b5ac-238b404fefd2

