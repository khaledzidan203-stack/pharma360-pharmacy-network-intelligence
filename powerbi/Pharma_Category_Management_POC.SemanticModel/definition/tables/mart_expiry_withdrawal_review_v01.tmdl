	partition mart_expiry_withdrawal_review_v01 = m
		mode: import
		source =
				let
					Source = Parquet.Document(File.Contents(PharmaDataRoot & "\marts\mart_expiry_withdrawal_review_v01.parquet")),
					#"Type Checked" = Table.TransformColumnTypes(Source, {{"id", type text}, {"world_id", type text}, {"as_of_label", type text}, {"location", type text}, {"sku", type text}, {"category", type text}, {"lot", type text}, {"status", type text}, {"expiry_month_label", type text}, {"expiry_precision", type text}, {"three_month_risk_band", type text}, {"six_month_age_bucket", type text}, {"review_lane", type text}, {"policy_status", type text}, {"source_world", type text}, {"scenario_assumption", type text}, {"physical_qty", Int64.Type}, {"released_atp_units", Int64.Type}, {"withdrawal_due_physical_units", Int64.Type}, {"short_life_atp_units", Int64.Type}, {"long_life_atp_units", Int64.Type}, {"uncertain_atp_units", Int64.Type}, {"qa_held_physical_units", Int64.Type}, {"withdrawn_physical_units", Int64.Type}, {"hypothetical_excess_lane_units", Int64.Type}, {"approved_movement_units", Int64.Type}}, "en-US"),
					#"No Approved Actions" = if List.Sum(#"Type Checked"[approved_movement_units]) = 0 then #"Type Checked" else error "UNAUTHORIZED_ACTION_QUANTITY",
					#"Original Synthetic World Only" = if Table.RowCount(Table.SelectRows(#"No Approved Actions", each [source_world] <> "ORIGINAL_SYNTHETIC_NO_INJECTED_TEST_STOCK")) = 0 then #"No Approved Actions" else error "TEST_STOCK_FORBIDDEN",
					#"Lot Grain" = if Table.RowCount(Table.Distinct(#"Original Synthetic World Only", {"id"})) = 4175 and Table.RowCount(#"Original Synthetic World Only") = 4175 then #"Original Synthetic World Only" else error "LOT_REVIEW_GRAIN_CHANGED"
				in
					#"Lot Grain"

