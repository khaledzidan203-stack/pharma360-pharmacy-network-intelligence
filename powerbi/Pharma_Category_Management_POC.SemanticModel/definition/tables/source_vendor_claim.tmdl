	partition source_vendor_claim = m
		mode: import
		source =
				let
				  Source = Parquet.Document(File.Contents(PharmaDataRoot & "/source/vendor_claim.parquet")),
				  Nested = Source,
				  Typed = Table.TransformColumnTypes(Nested, {{"id", type text}, {"world_id", type text}, {"event_at", type text}, {"known_at", type text}, {"ingested_at", type text}, {"validated_at", type text}, {"supplier", type text}, {"location", type text}, {"sku", type text}, {"lot", type text}, {"qty", Int64.Type}, {"state", type text}, {"expected_credit_minor", Int64.Type}, {"issued_credit_minor", Int64.Type}}, "en-US"),
				  Dates0 = Table.AddColumn(Typed, "Event Date", each if Record.Field(_, "event_at") = null then null else Date.From(DateTimeZone.SwitchZone(DateTimeZone.FromText(Record.Field(_, "event_at")), 3)), type date),
				  Dates1 = Table.AddColumn(Dates0, "Known Date", each if Record.Field(_, "known_at") = null then null else Date.From(DateTimeZone.SwitchZone(DateTimeZone.FromText(Record.Field(_, "known_at")), 3)), type date)
				in
				  Dates1

