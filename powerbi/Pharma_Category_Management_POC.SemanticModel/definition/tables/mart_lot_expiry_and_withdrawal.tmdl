	partition mart_lot_expiry_and_withdrawal = m
		mode: import
		source =
				let
				  Source = Parquet.Document(File.Contents(PharmaDataRoot & "/marts/mart_lot_expiry_and_withdrawal.parquet")),
				  Nested = Source,
				  Typed = Table.TransformColumnTypes(Nested, {{"id", type text}, {"world_id", type text}, {"source_manifest_sha256", type text}, {"as_of", type text}, {"location", type text}, {"sku", type text}, {"lot", type text}, {"status", type text}, {"qty", Int64.Type}, {"expiry_year", Int64.Type}, {"expiry_month", Int64.Type}, {"expiry_precision", type text}, {"withdrawal_at", type text}, {"remaining_sellable_days", Int64.Type}, {"unit_cost_minor", Int64.Type}}, "en-US"),
				  Dates0 = Table.AddColumn(Typed, "As Of Date", each if Record.Field(_, "as_of") = null then null else Date.From(DateTimeZone.SwitchZone(DateTimeZone.FromText(Record.Field(_, "as_of")), 3)), type date),
				  Dates1 = Table.AddColumn(Dates0, "Withdrawal Date", each if Record.Field(_, "withdrawal_at") = null then null else Date.From(DateTimeZone.SwitchZone(DateTimeZone.FromText(Record.Field(_, "withdrawal_at")), 3)), type date)
