		annotation UnderlyingDateTimeDataType = Date

	partition decision_review = m
		mode: import
		source =
				let
				  Source = Parquet.Document(File.Contents(PharmaDataRoot & "/04_analytics/DECISION_ALTERNATIVES.parquet")),
				  Nested = Source,
				  Typed = Table.TransformColumnTypes(Nested, {{"decision_id", type text}, {"world_id", type text}, {"family", type text}, {"source_object", type text}, {"branch_id", type text}, {"sku_id", type text}, {"lot_id", type text}, {"data_as_of", type text}, {"decision_as_of", type text}, {"evidence_status", type text}, {"decision_status", type text}, {"reason", type text}, {"candidate_quantity", Int64.Type}, {"executable_quantity", Int64.Type}, {"approval_required", type logical}, {"owner_role", type text}, {"source_tier", type text}, {"source_manifest_sha256", type text}, {"evidence_json", type text}}, "en-US"),
				  Dates0 = Table.AddColumn(Typed, "Decision Date", each if Record.Field(_, "decision_as_of") = null then null else Date.From(DateTimeZone.SwitchZone(DateTimeZone.FromText(Record.Field(_, "decision_as_of")), 3)), type date)
				in
				  Dates0

