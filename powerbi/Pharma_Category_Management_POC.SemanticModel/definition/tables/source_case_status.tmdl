	partition source_case_status = m
		mode: import
		source =
				let
				  Source = Parquet.Document(File.Contents(PharmaDataRoot & "/05_executive_data/facts/fact_source_case_status.parquet")),
				  Nested = Table.TransformColumns(Source, {{"supporting_event_ids", each if _ = null then null else Text.FromBinary(Json.FromValue(_), TextEncoding.Utf8), type text}}),
				  Typed = Table.TransformColumnTypes(Nested, {{"world_id", type text}, {"case_id", type text}, {"status", type text}, {"as_of", type text}, {"reason", type text}, {"supporting_event_ids", type text}, {"source_evidence_path", type text}, {"source_manifest_sha256", type text}, {"executable_qty", Int64.Type}}, "en-US"),
				  Dates0 = Table.AddColumn(Typed, "As Of Date", each if Record.Field(_, "as_of") = null then null else Date.From(DateTimeZone.SwitchZone(DateTimeZone.FromText(Record.Field(_, "as_of")), 3)), type date)
				in
				  Dates0

