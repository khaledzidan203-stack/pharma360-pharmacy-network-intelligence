	partition fact_inbound_asof = m
		mode: import
		source =
				let
				  Source = Parquet.Document(File.Contents(PharmaDataRoot & "/marts/fact_inbound_asof.parquet")),
				  Nested = Source,
				  Typed = Table.TransformColumnTypes(Nested, {{"id", type text}, {"world_id", type text}, {"source_manifest_sha256", type text}, {"as_of", type text}, {"po", type text}, {"location", type text}, {"sku", type text}, {"firm_unreceived_qty", Int64.Type}, {"due_at", type text}, {"qualified_for_retail", type logical}, {"reason", type text}}, "en-US"),
				  Dates0 = Table.AddColumn(Typed, "As Of Date", each if Record.Field(_, "as_of") = null then null else Date.From(DateTimeZone.SwitchZone(DateTimeZone.FromText(Record.Field(_, "as_of")), 3)), type date),
				  Dates1 = Table.AddColumn(Dates0, "Promised Date", each if Record.Field(_, "due_at") = null then null else Date.From(DateTimeZone.SwitchZone(DateTimeZone.FromText(Record.Field(_, "due_at")), 3)), type date)
				in
				  Dates1

