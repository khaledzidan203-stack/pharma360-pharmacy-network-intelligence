	partition fact_lot_stock_asof = m
		mode: import
		source =
				let
				  Source = Parquet.Document(File.Contents(PharmaDataRoot & "/marts/fact_lot_stock_asof.parquet")),
				  Nested = Source,
				  Typed = Table.TransformColumnTypes(Nested, {{"id", type text}, {"world_id", type text}, {"source_manifest_sha256", type text}, {"as_of", type text}, {"location", type text}, {"sku", type text}, {"lot", type text}, {"status", type text}, {"physical_qty", Int64.Type}, {"saleable_qty", Int64.Type}, {"reserved_qty", Int64.Type}, {"atp_qty", Int64.Type}, {"cost_minor", Int64.Type}}, "en-US"),
				  Dates0 = Table.AddColumn(Typed, "As Of Date", each if Record.Field(_, "as_of") = null then null else Date.From(DateTimeZone.SwitchZone(DateTimeZone.FromText(Record.Field(_, "as_of")), 3)), type date)
				in
				  Dates0

