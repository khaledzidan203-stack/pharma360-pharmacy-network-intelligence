	measure 'P03 Branch Review Focus' =
			VAR Delta = [Branch Sales Change SAR]
			VAR PeerBranches = CALCULATETABLE(VALUES(dim_branch[location]),REMOVEFILTERS(dim_branch[location]))
			VAR WithDelta = ADDCOLUMNS(PeerBranches,"@P03Delta",CALCULATE([Branch Sales Change SAR]))
			VAR Declines = FILTER(WithDelta,[@P03Delta]<0)
			VAR LossRank = RANKX(Declines,[@P03Delta],Delta,ASC,Dense)
			VAR PeerGP = CALCULATE([P03 Latest3 GP SAR],REMOVEFILTERS(dim_branch[location]))
			VAR PeerSales = CALCULATE([P03 Latest3 Sales SAR],REMOVEFILTERS(dim_branch[location]))
			VAR PeerTWA = CALCULATE([P03 Latest3 TWA SAR],REMOVEFILTERS(dim_branch[location]))
			VAR PeerMargin = DIVIDE(PeerGP,PeerSales)
			VAR PeerGMROI = DIVIDE(PeerGP,PeerTWA)
			VAR LowMargin = NOT ISBLANK([P03 Latest3 Margin %]) && NOT ISBLANK(PeerMargin) && [P03 Latest3 Margin %] < PeerMargin
			VAR LowGMROI = NOT ISBLANK([P03 Latest3 GMROI]) && NOT ISBLANK(PeerGMROI) && [P03 Latest3 GMROI] < PeerGMROI
			RETURN IF(NOT HASONEVALUE(dim_branch[location]),BLANK(),
			    SWITCH(TRUE(),ISBLANK(Delta),"Not available",Delta>=0,"Monitor performance",
			        LossRank<=5 && LowMargin && LowGMROI,"Sales, margin & capital review",
			        LossRank<=5 && LowGMROI,"Sales & inventory review",
			        LossRank<=5 && LowMargin,"Sales & margin review",
			        LossRank<=5,"Sales recovery review",
			        LowMargin && LowGMROI,"Margin & inventory review",
			        "Monitor performance"))
		displayFolder: 03 Branch Performance\Page 03 Executive
		lineageTag: 7782be60-8001-58fe-abaa-be26df67af80

	measure 'P03 Daily Invoices' =
			VAR D = SELECTEDVALUE(dim_date[date])
			VAR StartDate = IF([Selected Period]="3M",DATE(2026,7,30),DATE(2026,4,30))
			RETURN IF(
			    ISBLANK(D) || D < StartDate || D >= DATE(2026,10,30),
			    BLANK(),
			    CALCULATE(
			        DISTINCTCOUNT(source_sale_line[invoice]),
			        REMOVEFILTERS(dim_date),
			        TREATAS({D},source_sale_line[Event Date])
			    )
			)
		formatString: #,##0
		displayFolder: 03 Branch Performance\Page 03 Executive
		lineageTag: 09624afb-1e32-520d-b286-3c41bc241219

	measure 'P03 Branch Loss Gradient Hex' =
			VAR V = [Branch Sales Change SAR]
			VAR Peer = ALLSELECTED(dim_branch[location])
			VAR Losses = FILTER(Peer,[Branch Sales Change SAR]<0)
			VAR Gains = FILTER(Peer,[Branch Sales Change SAR]>0)
			VAR Worst = MINX(Losses,[Branch Sales Change SAR])
			VAR LeastLoss = MAXX(Losses,[Branch Sales Change SAR])
			VAR SmallGain = MINX(Gains,[Branch Sales Change SAR])
			VAR LargeGain = MAXX(Gains,[Branch Sales Change SAR])
			VAR LossT = DIVIDE(V-Worst,LeastLoss-Worst,0.5)
			VAR GainT = DIVIDE(V-SmallGain,LargeGain-SmallGain,0.5)
			RETURN SWITCH(TRUE(),
			    ISBLANK(V),"#8999A9",
			    V<0 && LossT<0.125,"#AE304B",
			    V<0 && LossT<0.250,"#BB3A54",
			    V<0 && LossT<0.375,"#C54863",
			    V<0 && LossT<0.500,"#CE5770",
			    V<0 && LossT<0.625,"#D66C81",
			    V<0 && LossT<0.750,"#DE8394",
			    V<0 && LossT<0.875,"#E5A0AC",
			    V<0,"#EAB7C0",
			    V>0 && GainT<0.250,"#8BCBB8",
			    V>0 && GainT<0.500,"#64BAA2",
			    V>0 && GainT<0.750,"#3DAE91",
			    V>0,"#1B927A", "#AAB3BF")
		displayFolder: 03 Branch Performance\Page 03 Executive
		lineageTag: d1fe4e9b-2950-5a5a-953b-dfa9669382ce

	measure 'P03 Format Sales Gradient Hex' =
			VAR V = [P03 Format Sales Per Store]
			VAR Peer = ALLSELECTED(dim_branch[format])
			VAR Lo = MINX(Peer,[P03 Format Sales Per Store])
			VAR Hi = MAXX(Peer,[P03 Format Sales Per Store])
			VAR T = DIVIDE(V-Lo,Hi-Lo,0.5)
			RETURN SWITCH(TRUE(),ISBLANK(V),"#8999A9",V<0,"#C54863",
			    T<0.125,"#ACD7EB",T<0.250,"#92CBE6",T<0.375,"#7DBDDD",
