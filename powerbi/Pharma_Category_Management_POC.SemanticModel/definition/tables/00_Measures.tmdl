			VAR Largest5 = TOPN(5,Candidates,[Branch Sales Change SAR],ASC,dim_branch[location],ASC)
			RETURN IF(COUNTROWS(Candidates)=0,BLANK(),SUMX(Largest5,-[Branch Sales Change SAR]))
