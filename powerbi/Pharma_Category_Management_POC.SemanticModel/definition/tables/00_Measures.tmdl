		lineageTag: dee53a71-da10-5f06-b4ec-237f0630d990

	/// Selected Method
	measure 'Selected Method' = IF(ISFILTERED(forecast_evaluation[method]),SELECTEDVALUE(forecast_evaluation[method]),"MEAN28")
