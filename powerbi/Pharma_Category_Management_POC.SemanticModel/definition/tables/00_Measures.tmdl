	measure 'P01 Basket Effect Magnitude' = ABS([Network Basket Value Bridge SAR])
		formatString: #,##0.00
		displayFolder: 01 Executive Finance\Page 01 Display
		lineageTag: 66c3c8d8-8ed9-4f6f-b6e7-2591dc3ee5a1

	measure 'P01 Branch Intensity' =
			VAR V = [Branch Sales Change SAR]
			VAR SelectedItems = ALLSELECTED(dim_branch[location])
			VAR MaxLoss = MAXX(SelectedItems, ABS(CALCULATE([Branch Sales Change SAR])))
			VAR MinLoss = MINX(SelectedItems, ABS(CALCULATE([Branch Sales Change SAR])))
			VAR T = MAX(0, MIN(1, DIVIDE(ABS(V) - MinLoss, MaxLoss - MinLoss, 1)))
			VAR R = ROUND(IF(V < 0, 243 - 32 * T, 165 - 132 * T), 0)
			VAR G = ROUND(IF(V < 0, 166 - 127 * T, 228 - 45 * T), 0)
			VAR B = ROUND(IF(V < 0, 180 - 94 * T, 219 - 55 * T), 0)
			VAR H = "0123456789ABCDEF"
			RETURN IF(ISBLANK(V), BLANK(), "#" & MID(H, INT(R/16)+1, 1) & MID(H, MOD(R,16)+1, 1) & MID(H, INT(G/16)+1, 1) & MID(H, MOD(G,16)+1, 1) & MID(H, INT(B/16)+1, 1) & MID(H, MOD(B,16)+1, 1))
		displayFolder: 01 Executive Finance\Page 01 Display
		lineageTag: 7af14780-9402-4abf-8fd0-9ebf64208f7a

	measure 'P01 Category Intensity' =
			VAR V = [Category Sales Change SAR]
			VAR SelectedItems = ALLSELECTED(dim_category[category])
			VAR MaxLoss = MAXX(SelectedItems, ABS(CALCULATE([Category Sales Change SAR])))
			VAR MinLoss = MINX(SelectedItems, ABS(CALCULATE([Category Sales Change SAR])))
			VAR T = MAX(0, MIN(1, DIVIDE(ABS(V) - MinLoss, MaxLoss - MinLoss, 1)))
			VAR R = ROUND(IF(V < 0, 243 - 32 * T, 165 - 132 * T), 0)
			VAR G = ROUND(IF(V < 0, 166 - 127 * T, 228 - 45 * T), 0)
			VAR B = ROUND(IF(V < 0, 180 - 94 * T, 219 - 55 * T), 0)
			VAR H = "0123456789ABCDEF"
			RETURN IF(ISBLANK(V), BLANK(), "#" & MID(H, INT(R/16)+1, 1) & MID(H, MOD(R,16)+1, 1) & MID(H, INT(G/16)+1, 1) & MID(H, MOD(G,16)+1, 1) & MID(H, INT(B/16)+1, 1) & MID(H, MOD(B,16)+1, 1))
		displayFolder: 01 Executive Finance\Page 01 Display
		lineageTag: 92e9bfc4-fcbf-43bf-999d-bcd0716d01f4

	measure 'P01 Invoice Effect Magnitude' = ABS([Network Invoice Volume Bridge SAR])
		formatString: #,##0.00
		displayFolder: 01 Executive Finance\Page 01 Display
		lineageTag: 1ab412a1-2a40-42e9-a9eb-cc7823808d6a

	measure 'P01 Latest Margin' = DIVIDE([Network Latest GP], [Network Latest Sales])
		formatString: 0.000%
