		lineageTag: 684f45c2-e276-5cf0-9936-fda0451cea70

	/// Executive Invoices Display
	measure 'Executive Invoices Display' = VAR Amount = [Network Latest Invoices] VAR CompactValue = SWITCH(TRUE(), ISBLANK(Amount), "N/A", ABS(Amount) >= 1000000000, FORMAT(Amount / 1000000000, "0.00") & "B", ABS(Amount) >= 1000000, FORMAT(Amount / 1000000, "0.00") & "M", ABS(Amount) >= 1000, FORMAT(Amount / 1000, "0.0") & "K", FORMAT(Amount, "#,0")) RETURN CompactValue & " | " & FORMAT([Network Invoice Change %], "+0.0%;-0.0%;0.0%")
