	/// SKU Pareto %
	measure 'SKU Pareto %' = VAR CurrentSales=[SKU Sales SAR] RETURN DIVIDE(SUMX(FILTER(ALLSELECTED(dim_product[sku]),[SKU Sales SAR]>=CurrentSales),[SKU Sales SAR]),CALCULATE([SKU Sales SAR],ALLSELECTED(dim_product[sku])))
