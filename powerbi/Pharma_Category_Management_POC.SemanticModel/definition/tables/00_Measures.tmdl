	/// Selected Evaluation Partition
	measure 'Selected Evaluation Partition' = IF(ISFILTERED(forecast_evaluation[partition]),SELECTEDVALUE(forecast_evaluation[partition]),"VALIDATION")
		displayFolder: 10 Forecasting
		lineageTag: 167a606d-d9a9-5109-93a0-26d9888987f0

	/// Forecast Error P90
	measure 'Forecast Error P90' = VAR H=[Selected Horizon] VAR M=[Selected Method] VAR P=[Selected Evaluation Partition] RETURN IF(NOT ISBLANK(H) && NOT ISBLANK(M) && NOT ISBLANK(P),CALCULATE(PERCENTILEX.INC(forecast_evaluation,forecast_evaluation[absolute_error],0.9),forecast_evaluation[horizon_days]=H,forecast_evaluation[method]=M,forecast_evaluation[partition]=P),BLANK())
		formatString: #,##0.00
		displayFolder: 10 Forecasting
		lineageTag: fcf680bb-4c79-503d-b4e5-af0fd8d61ec2

	/// Forecast Error Median
	measure 'Forecast Error Median' = VAR H=[Selected Horizon] VAR M=[Selected Method] VAR P=[Selected Evaluation Partition] RETURN IF(NOT ISBLANK(H) && NOT ISBLANK(M) && NOT ISBLANK(P),CALCULATE(MEDIAN(forecast_evaluation[absolute_error]),forecast_evaluation[horizon_days]=H,forecast_evaluation[method]=M,forecast_evaluation[partition]=P),BLANK())
		formatString: #,##0.00
		displayFolder: 10 Forecasting
		lineageTag: 2e1dfefe-978a-5792-ab3c-335e6839c727

	/// Candidate Selection Guidance
	measure 'Candidate Selection Guidance' = IF([Candidate Context Ready]=1,"Historical candidate selected; review evidence only","Select one historical candidate to inspect constraints")
		displayFolder: 08 Replenishment & Constraints
		lineageTag: dfc5eee0-3480-5ccd-ac38-279c1297055a

	/// Exact saved candidate-to-D06 source_object join only; absent historical review stays NULL
	measure 'Historical Requested EACH' = IF([Candidate Context Ready]=1,CALCULATE(MAX(decision_review[candidate_quantity]),REMOVEFILTERS(dim_date),TREATAS(VALUES(source_constraint_component[candidate_id]),decision_review[source_object]),decision_review[family]="D06"),BLANK())
		formatString: #,0
		displayFolder: 08 Replenishment & Constraints
		lineageTag: bbdf4b9d-ca50-54ac-8928-87eeeaa284ff

	/// Category Change Color
	measure 'Category Change Color' = IF(ISBLANK([Category Sales Change SAR]),"#B8C8DD",IF([Category Sales Change SAR]<0,"#C9475A",IF([Category Sales Change SAR]>0,"#1B9E95","#B8C8DD")))
		displayFolder: 14 Dynamic Formatting
		lineageTag: 5a448060-a0ea-5c82-966f-8c82a1fffdd8

	/// Branch Change Color
	measure 'Branch Change Color' = VAR _v = [Branch Sales Change SAR] VAR _peer = ALLSELECTED('dim_branch'[location]) VAR _losses = FILTER(_peer, [Branch Sales Change SAR] < 0) VAR _gains = FILTER(_peer, [Branch Sales Change SAR] > 0) VAR _worstLoss = MINX(_losses, [Branch Sales Change SAR]) VAR _smallestLoss = MAXX(_losses, [Branch Sales Change SAR]) VAR _smallestGain = MINX(_gains, [Branch Sales Change SAR]) VAR _largestGain = MAXX(_gains, [Branch Sales Change SAR]) VAR _lossT = DIVIDE(_v - _worstLoss, _smallestLoss - _worstLoss, 0.5) VAR _gainT = DIVIDE(_v - _smallestGain, _largestGain - _smallestGain, 0.5) RETURN SWITCH(TRUE(), ISBLANK(_v), "#8999A9", _v < 0 && _lossT < 0.125, "#AE304B", _v < 0 && _lossT < 0.250, "#BB3A54", _v < 0 && _lossT < 0.375, "#C54863", _v < 0 && _lossT < 0.500, "#CE5770", _v < 0 && _lossT < 0.625, "#D66C81", _v < 0 && _lossT < 0.750, "#DE8394", _v < 0 && _lossT < 0.875, "#E5A0AC", _v < 0, "#EAB7C0", _v > 0 && _gainT < 0.250, "#8BCBB8", _v > 0 && _gainT < 0.500, "#64BAA2", _v > 0 && _gainT < 0.750, "#3DAE91", _v > 0, "#1B927A", "#AAB3BF")
		displayFolder: 14 Dynamic Formatting
		lineageTag: 94c57f75-5485-522f-a50e-e00b583bf043

	/// Executive Narrative
	measure 'Executive Narrative' = "Latest 3M sales " & FORMAT([Network Sales Change %],"+0.0%;-0.0%;0.0%") & "; invoices " & FORMAT([Network Invoice Change %],"+0.0%;-0.0%;0.0%") & "; ABV " & FORMAT([Network ABV Change %],"+0.0%;-0.0%;0.0%") & ". Arithmetic attribution only; not customer-demand causality. Review category/branch contributors and saved exposure."
		displayFolder: 01 Executive Finance
		lineageTag: 7ffe63b4-3e67-5716-a5cf-ad56a941dc6d

	/// Executive Sales Display
	measure 'Executive Sales Display' = VAR Amount = [Network Latest Sales] VAR CompactValue = SWITCH(TRUE(), ISBLANK(Amount), "N/A", ABS(Amount) >= 1000000000, FORMAT(Amount / 1000000000, "0.00") & "B", ABS(Amount) >= 1000000, FORMAT(Amount / 1000000, "0.00") & "M", ABS(Amount) >= 1000, FORMAT(Amount / 1000, "0.0") & "K", FORMAT(Amount, "#,##0.00")) RETURN CompactValue & " | " & FORMAT([Network Sales Change %], "+0.0%;-0.0%;0.0%")
		displayFolder: 01 Executive Finance
		lineageTag: 19a1e917-8eed-5fc1-a674-d4bbf0d32ab7

	/// Executive GP Display
	measure 'Executive GP Display' = VAR Amount = [Network Latest GP] VAR CompactValue = SWITCH(TRUE(), ISBLANK(Amount), "N/A", ABS(Amount) >= 1000000000, FORMAT(Amount / 1000000000, "0.00") & "B", ABS(Amount) >= 1000000, FORMAT(Amount / 1000000, "0.00") & "M", ABS(Amount) >= 1000, FORMAT(Amount / 1000, "0.0") & "K", FORMAT(Amount, "#,##0.00")) RETURN CompactValue & " | " & FORMAT([Network GP Change %], "+0.0%;-0.0%;0.0%")
