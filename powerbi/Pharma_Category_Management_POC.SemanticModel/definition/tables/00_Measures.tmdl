	/// Color-only gradient for Branch Gross Profit SAR; not a KPI.
	measure 'Branch GP Gradient Color' = VAR _v = [Branch Gross Profit SAR] VAR _peer = ALLSELECTED('dim_branch'[location]) VAR _low = MINX(_peer, [Branch Gross Profit SAR]) VAR _high = MAXX(_peer, [Branch Gross Profit SAR]) VAR _t = DIVIDE(_v - _low, _high - _low, 0.5) RETURN SWITCH(TRUE(), ISBLANK(_v), "#8999A9", _v < 0, "#CC6674", _t < 0.125, "#ACD7EB", _t < 0.250, "#92CBE6", _t < 0.375, "#7DBDDD", _t < 0.500, "#67AED6", _t < 0.625, "#509DCD", _t < 0.750, "#3E8DC0", _t < 0.875, "#2F7CB4", "#206BA5")
