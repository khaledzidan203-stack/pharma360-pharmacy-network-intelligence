table 00_Measures
	lineageTag: b347e138-ea6a-5976-a1f4-4bc42babdf70

	/// Selected Period
	measure 'Selected Period' = IF(ISFILTERED(PeriodSelector[Period]),SELECTEDVALUE(PeriodSelector[Period]),"3M")
		displayFolder: 15 Navigation & Utility
		lineageTag: b81fcc13-bd7b-5ef4-88e0-1552c354daac

	/// Selected As Of
	measure 'Selected As Of' = IF(ISFILTERED(SnapshotSelector[AsOf]),SELECTEDVALUE(SnapshotSelector[AsOf]),"2026-10-30T00:00:00+03:00")
		displayFolder: 15 Navigation & Utility
		lineageTag: f69f3809-0532-555b-9e3a-a2ce690e4512

	/// Selected Horizon
	measure 'Selected Horizon' = IF(ISFILTERED(HorizonSelector[Days]),SELECTEDVALUE(HorizonSelector[Days]),14)
