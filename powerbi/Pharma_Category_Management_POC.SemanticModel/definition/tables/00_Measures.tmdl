	/// Matched Source Invoices
	measure 'Matched Source Invoices' = VAR StartDate=IF([Selected Period]="3M",DATE(2026,7,30),DATE(2026,4,30)) RETURN CALCULATE(DISTINCTCOUNT(source_sale_line[invoice]),REMOVEFILTERS(dim_date), source_sale_line[Event Date]>=StartDate, source_sale_line[Event Date]<DATE(2026,10,30))
		formatString: #,##0
		displayFolder: 15 Navigation & Utility
		lineageTag: aaa00d7f-0f6f-5943-9230-f2f619193d58

