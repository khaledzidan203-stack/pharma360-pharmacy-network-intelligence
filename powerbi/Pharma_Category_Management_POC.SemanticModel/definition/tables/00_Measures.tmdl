	/// Executive ABV Display
	measure 'Executive ABV Display' = VAR Amount = [Network Latest ABV] VAR CompactValue = SWITCH(TRUE(), ISBLANK(Amount), "N/A", ABS(Amount) >= 1000000000, FORMAT(Amount / 1000000000, "0.00") & "B", ABS(Amount) >= 1000000, FORMAT(Amount / 1000000, "0.00") & "M", ABS(Amount) >= 1000, FORMAT(Amount / 1000, "0.0") & "K", FORMAT(Amount, "#,##0.00")) RETURN CompactValue & " | " & FORMAT([Network ABV Change %], "+0.0%;-0.0%;0.0%")
