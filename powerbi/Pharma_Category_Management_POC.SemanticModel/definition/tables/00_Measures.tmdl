	measure 'P02 Review Focus' =
			VAR L=[P02 Loss Rank]
			VAR R=[P02 Relative Decline Rank]
			VAR G=[P02 GMROI Weakness Rank]
			VAR M=[P02 Latest3 Margin]
			VAR ROI=[P02 Latest3 GMROI]
			RETURN IF([P02 Focus Flag]<>1, BLANK(),
			   SWITCH(TRUE(),
			     R=1 && G=1, "Steep decline & low GMROI",
			     L<=3 && ROI<[P02 Network Latest3 GMROI], "Sales loss & inventory efficiency",
			     L<=3 && M>=[P02 Network Latest3 Margin] && ROI>=[P02 Network Latest3 GMROI], "Recover sales • protect margin",
			     L<=3, "Investigate sales & margin",
			     G=1, "Inventory efficiency review",
			     "Review category performance"))
		displayFolder: 02 Category Performance\Page02 V02
		lineageTag: fb4b0d96-29e7-5f5b-9561-8bf28394e55c

	measure 'P02 Top3 Network GP SAR' =
			VAR T =
			    CALCULATETABLE(
			        ADDCOLUMNS(VALUES(dim_category[category]), "__GP", [Category Gross Profit SAR]),
			        REMOVEFILTERS(dim_category)
			    )
			VAR N = TOPN(3, T, [__GP], DESC, dim_category[category], ASC)
			RETURN IF(MINX(T,[__GP])<0, BLANK(), SUMX(N,[__GP]))
		formatString: #,##0.00
		displayFolder: 02 Category Performance\Page02 V02
		lineageTag: 76ed8abd-44ff-5daf-8ad2-6ac5a71bfc26

	measure 'P02 Remaining Network GP SAR' =
			VAR NetGP = CALCULATE([Category Gross Profit SAR], REMOVEFILTERS(dim_category))
			VAR Top3 = [P02 Top3 Network GP SAR]
			RETURN IF(ISBLANK(Top3) || ISBLANK(NetGP),BLANK(),MAX(0,NetGP-Top3))
		formatString: #,##0.00
		displayFolder: 02 Category Performance\Page02 V02
		lineageTag: 4f236b24-7eeb-5572-ad39-f33294373b9d

	measure 'P02 Loss Severity Color' =
			VAR V = [Category Sales Change SAR]
			VAR Peers =
			    ADDCOLUMNS(
			        ALL(dim_category[category]),
			        "__Metric", CALCULATE([Category Sales Change SAR])
			    )
			VAR SameSign =
			    FILTER(Peers,
			        NOT ISBLANK([__Metric]) &&
			        IF(V < 0, [__Metric] < 0, [__Metric] > 0)
			    )
			VAR LowMagnitude = MINX(SameSign, ABS([__Metric]))
			VAR HighMagnitude = MAXX(SameSign, ABS([__Metric]))
			VAR Scale = IF(HighMagnitude = LowMagnitude, 0.5,
			    MAX(0, MIN(1, DIVIDE(ABS(V)-LowMagnitude, HighMagnitude-LowMagnitude, 0.5))))
			VAR RedBin = MIN(8, 1 + INT(8*Scale))
			VAR GreenBin = MIN(4, 1 + INT(4*Scale))
			RETURN SWITCH(TRUE(),
			    ISBLANK(V) || V=0, "#8999A9",
			    V<0, SWITCH(RedBin,
			        1,"#EAB7C0",2,"#E5A0AC",3,"#DE8394",4,"#D66C81",
			        5,"#CE5770",6,"#C54863",7,"#BB3A54","#AE304B"),
			    SWITCH(GreenBin,1,"#8BCBB8",2,"#64BAA2",3,"#3DAE91","#1B927A")
			)
		displayFolder: 02 Category Performance\Page02 V02
		lineageTag: b6397f94-8905-5100-912a-69c6ce3321e5

	measure 'P02 Profit Advantage Color' =
			VAR V = [P02 GP Share Advantage pp]
			VAR Peers =
			    ADDCOLUMNS(
			        ALL(dim_category[category]),
			        "__Metric", CALCULATE([P02 GP Share Advantage pp])
			    )
			VAR SameSign =
			    FILTER(Peers,
			        NOT ISBLANK([__Metric]) &&
			        IF(V < 0, [__Metric] < 0, [__Metric] > 0)
			    )
			VAR LowMagnitude = MINX(SameSign, ABS([__Metric]))
			VAR HighMagnitude = MAXX(SameSign, ABS([__Metric]))
			VAR Scale = IF(HighMagnitude = LowMagnitude, 0.5,
			    MAX(0, MIN(1, DIVIDE(ABS(V)-LowMagnitude, HighMagnitude-LowMagnitude, 0.5))))
			VAR RedBin = MIN(8, 1 + INT(8*Scale))
			VAR GreenBin = MIN(4, 1 + INT(4*Scale))
			RETURN SWITCH(TRUE(),
			    ISBLANK(V) || V=0, "#8999A9",
			    V<0, SWITCH(RedBin,
			        1,"#EAB7C0",2,"#E5A0AC",3,"#DE8394",4,"#D66C81",
			        5,"#CE5770",6,"#C54863",7,"#BB3A54","#AE304B"),
			    SWITCH(GreenBin,1,"#8BCBB8",2,"#64BAA2",3,"#3DAE91","#1B927A")
			)
		displayFolder: 02 Category Performance\Page02 V02
		lineageTag: 4007fd93-3a6a-550e-8360-b61f56498402

