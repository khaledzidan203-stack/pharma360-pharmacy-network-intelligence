	/// Network Sales SAR
	measure 'Network Sales SAR' = VAR P = [Selected Period] RETURN CALCULATE(DIVIDE(SUM(mart_network_finance_period[net_sales_minor]),100), mart_network_finance_period[period] = P)
		formatString: #,##0.00
		displayFolder: 01 Executive Finance
