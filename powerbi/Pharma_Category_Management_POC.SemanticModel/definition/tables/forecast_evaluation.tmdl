		annotation UnderlyingDateTimeDataType = Date

	partition forecast_evaluation = m
		mode: import
		source =
				let
				  Source = Parquet.Document(File.Contents(PharmaDataRoot & "/04_analytics/FORECAST_BACKTEST_RESULTS.parquet")),
				  Nested = Source,
				  Typed = Table.TransformColumnTypes(Nested, {{"world_id", type text}, {"location", type text}, {"sku", type text}, {"origin", type text}, {"training_end_exclusive", type text}, {"horizon_days", Int64.Type}, {"method", type text}, {"partition", type text}, {"segment", type text}, {"actual_fulfilled_units", type number}, {"forecast_units", type number}, {"error_units", type number}, {"absolute_error", type number}, {"lower_heuristic", type number}, {"upper_heuristic", type number}, {"covered", type logical}, {"availability_censored", type logical}, {"source_manifest_sha256", type text}, {"target", type text}, {"selected_on_validation", type logical}}, "en-US"),
				  Dates0 = Table.AddColumn(Typed, "Forecast Origin Date", each if Record.Field(_, "origin") = null then null else Date.From(DateTimeZone.SwitchZone(DateTimeZone.FromText(Record.Field(_, "origin")), 3)), type date)
				in
				  Dates0

