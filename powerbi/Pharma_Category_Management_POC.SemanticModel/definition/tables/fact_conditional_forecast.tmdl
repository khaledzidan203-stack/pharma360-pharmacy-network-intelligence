	partition fact_conditional_forecast = m
		mode: import
		source =
				let
				  Source = Parquet.Document(File.Contents(PharmaDataRoot & "/05_executive_data/facts/fact_conditional_forecast.parquet")),
				  Nested = Source,
				  Typed = Table.TransformColumnTypes(Nested, {{"world_id", type text}, {"location", type text}, {"sku", type text}, {"forecast_origin", type text}, {"horizon_days", Int64.Type}, {"model", type text}, {"segment", type text}, {"conditional_nominal_fulfilled_units", type number}, {"approved_calendar_fulfilled_forecast", type text}, {"latent_demand", type text}, {"lost_sales", type text}, {"status", type text}, {"reason", type text}, {"source_manifest_sha256", type text}, {"executable_qty", Int64.Type}}, "en-US"),
				  Dates0 = Table.AddColumn(Typed, "Forecast Origin Date", each if Record.Field(_, "forecast_origin") = null then null else Date.From(DateTimeZone.SwitchZone(DateTimeZone.FromText(Record.Field(_, "forecast_origin")), 3)), type date)
				in
				  Dates0

