				  Typed = Table.TransformColumnTypes(Nested, {{"id", type text}, {"world_id", type text}, {"source_manifest_sha256", type text}, {"as_of", type text}, {"location", type text}, {"sku", type text}, {"reserved_qty", Int64.Type}, {"atp_qty", Int64.Type}, {"physical_qty", Int64.Type}, {"saleable_qty", Int64.Type}, {"held_qty", Int64.Type}, {"withdrawn_qty", Int64.Type}, {"cost_minor", Int64.Type}}, "en-US"),
